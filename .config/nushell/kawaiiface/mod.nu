export def pick_random [] {
  let faces = [
    "(▰˘◡˘▰)",
    "(✿◠‿◠)",
    "(◕‿◕✿)",
    "⊂◉‿◉つ",
    "(●⌒∇⌒●)",
    "(๑✧◡✧๑)",
    "o(^▽^)o",
    "（⌒▽⌒）",
    "(◍•ᴗ•◍)❤",
    "★~(◡△◕✿)",
    "(　´∀｀)",
    "(●*∩_∩*●)",
    "★~(◡︿◕✿)",
    "(＝⌒▽⌒＝)",
    "Ｏ(≧∇≦)Ｏ",
    "(^・ω・^ )",
    "(=^ ▽ ^=)",
    "(。・ω・。)",
    "o(｀・∀・´)○",
    "(づ￣ ³￣)づ",
    "(⋈◍＞◡＜◍)。✧♡",
    ]

    let rval = (random int ..(($faces | length) - 1))

    return ($faces | get $rval)
}
